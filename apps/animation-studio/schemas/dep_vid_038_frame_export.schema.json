{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dep_vid_038_frame_export",
  "title": "Character Frame Export (DEP-VID-038)",
  "description": "Transparent PNG frame sequences per beat. FR-VID-13 §4 Stage 6.",
  "type": "object",
  "required": ["job_id", "character_id", "beat_index", "target_format", "scene_id", "status", "total_frames", "frames_rendered", "output_path"],
  "properties": {
    "job_id": { "type": "string", "pattern": "^EXPORT-" },
    "character_id": { "type": "string", "pattern": "^CHAR-" },
    "beat_index": { "type": "integer", "minimum": 0 },
    "target_format": { "type": "string", "enum": ["9:16", "1:1", "16:9", "4:5"] },
    "scene_id": { "type": "string", "pattern": "^SC-0[1-8]$" },
    "status": { "type": "string", "enum": ["queued", "processing", "completed", "failed"] },
    "total_frames": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "frames_rendered": { "type": "integer", "minimum": 0 },
    "output_path": { "type": "string" },
    "fps": { "type": "integer", "default": 24 },
    "error": { "type": "string" }
  }
}
