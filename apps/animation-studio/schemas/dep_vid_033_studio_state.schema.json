{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dep_vid_033_studio_state",
  "title": "Studio Project State (DEP-VID-033)",
  "description": "Editor state: selected beat, bone, clip, scene selections. FR-VID-13 §5 Schema E.",
  "type": "object",
  "required": ["session_token", "selected_beat_index", "selected_bone", "target_format", "playback_state", "unsaved_patch", "volume_levels"],
  "properties": {
    "session_token": { "type": "string", "pattern": "^SES-" },
    "selected_beat_index": { "type": "integer", "minimum": 0 },
    "selected_bone": { "type": ["string", "null"] },
    "target_format": { "type": "string", "enum": ["9:16", "1:1", "16:9", "4:5"] },
    "playback_state": {
      "type": "object",
      "required": ["is_playing", "current_frame", "loop_beat"],
      "properties": {
        "is_playing": { "type": "boolean" },
        "current_frame": { "type": "integer", "minimum": 0 },
        "loop_beat": { "type": "boolean" }
      }
    },
    "unsaved_patch": { "type": ["object", "null"] },
    "volume_levels": {
      "type": "object",
      "required": ["voiceover", "music"],
      "properties": {
        "voiceover": { "type": "number", "minimum": 0, "maximum": 1 },
        "music": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
